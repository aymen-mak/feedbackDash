{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "User Sidebar",
    "description": "Discord-style online/offline user list sidebar for your Slack workspace",
    "background_color": "#2b2d31"
  },
  "features": {
    "bot_user": {
      "display_name": "User Sidebar",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "users:read",
        "users:read.email"
      ],
      "user": [
        "users:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
