# ─── Discord (required) ───────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Application (client) ID from the same app → General Information
DISCORD_CLIENT_ID=
# Your server ID (right-click the server icon → Copy Server ID, needs Developer Mode).
# Set this so slash commands appear instantly; leave blank to register globally.
DISCORD_GUILD_ID=

# ─── Local archiving ──────────────────────────────────────────────────
# Folder where transcripts are saved on the machine running the bot.
TRANSCRIPT_DIR=./transcripts
# Optional: channel ID where every archive is also posted (audit trail).
LOG_CHANNEL_ID=

# ─── Google Drive (optional) ──────────────────────────────────────────
# Drive folder to upload into (the folder ID from its URL). Leave blank for root.
GOOGLE_DRIVE_FOLDER_ID=
# Upload to Drive automatically without needing /archive upload:true
DRIVE_UPLOAD_DEFAULT=false

# --- Option A: Service account (recommended with a Shared Drive) ---
# Paste the full JSON key on one line, OR point to a file with the next var.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# --- Option B: OAuth2 (upload into a normal "My Drive" folder you own) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
