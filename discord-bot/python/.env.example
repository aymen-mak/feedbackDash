# These map 1:1 to Pterodactyl "Variables". You can set them in the panel
# instead of using a .env file.

# ─── Discord (required) ───────────────────────────────────────────────
DISCORD_TOKEN=
# Your server ID — set it so /archive appears instantly. Leave blank = global.
DISCORD_GUILD_ID=

# ─── Delivery ─────────────────────────────────────────────────────────
# The transcript is always sent as a Discord attachment (download it to your
# PC). Set SAVE_LOCAL=true only if you ALSO want a copy on the server's disk
# (uses limited Pterodactyl disk). Leave false to keep disk usage at zero.
SAVE_LOCAL=false
# Folder used only when SAVE_LOCAL=true.
TRANSCRIPT_DIR=./transcripts
# Optional channel ID to also post every archive to (a handy download hub).
LOG_CHANNEL_ID=

# ─── Archive button panel ─────────────────────────────────────────────
# Auto-post the "Archive" buttons into new ticket channels.
AUTO_PANEL=true
# A channel counts as a ticket if its name starts with this (MEE6 default).
TICKET_NAME_PREFIX=ticket

# ─── Google Drive (optional) ──────────────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_UPLOAD_DEFAULT=false

# Option A: service account (recommended with a Shared Drive)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# Option B: OAuth2 (upload into a normal "My Drive" folder you own)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
